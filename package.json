{
  "name": "@saiuttej/nestjs-mailer",
  "version": "1.0.0",
  "description": "NestJS module for sending email through Amazon SES and Mailtrap.",
  "author": "B Sai Uttej",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ses": {
      "types": "./dist/ses.d.ts",
      "default": "./dist/ses.js"
    },
    "./mailtrap": {
      "types": "./dist/mailtrap.d.ts",
      "default": "./dist/mailtrap.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saiuttej-b/nestjs-mailer"
  },
  "bugs": {
    "url": "https://github.com/saiuttej-b/nestjs-mailer/issues"
  },
  "keywords": [
    "nestjs",
    "email",
    "mailer",
    "ses",
    "mailtrap",
    "nodemailer",
    "aws-ses"
  ],
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/migrations/**/*.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "local": "pnpm i && pnpm build && pnpm pack"
  },
  "packageManager": "pnpm@10.15.0",
  "peerDependencies": {
    "@aws-sdk/client-ses": "^3.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "mailtrap": "^5.0.0",
    "nodemailer": "^9.0.1 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-ses": {
      "optional": true
    },
    "mailtrap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "^3.1152.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.24",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "mailtrap": "^5.0.0",
    "nodemailer": "^10.1.6",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "unrs-resolver"
    ]
  }
}
